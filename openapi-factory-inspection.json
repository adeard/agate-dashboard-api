{
  "openapi": "3.0.3",
  "info": {
    "title": "Factory Inspection Data API",
    "description": "API endpoints for factories to authenticate and retrieve grading inspection data (list & detail) based on the AGATE payload format.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3079/api/v5",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/factory-auth/login": {
      "post": {
        "summary": "Factory Login",
        "description": "Authenticate factory using API credentials (api_key and api_secret) and return JWT access token.",
        "tags": ["Authentication"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FactoryLoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FactoryLoginResponse"
                }
              }
            }
          },
          "401": {
            "description": "Invalid api_key or api_secret",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/factory-inspection": {
      "get": {
        "summary": "Get Inspection Data List (Summary)",
        "description": "Get a paginated list of inspection data scoped to the authenticated factory. Filterable by ticket number, SPB number, and date range.",
        "tags": ["Inspection Data"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "ticket_number",
            "in": "query",
            "description": "Filter by ticket number / ticket_id (case-insensitive partial match)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "delivery_number",
            "in": "query",
            "description": "Filter by SPB number / spb_no (case-insensitive partial match)",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date_from",
            "in": "query",
            "description": "Filter by start date (YYYY-MM-DD)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "date_to",
            "in": "query",
            "description": "Filter by end date (YYYY-MM-DD)",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "page",
            "in": "query",
            "description": "Page number",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Items per page",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InspectionListResponse"
                }
              }
            }
          },
          "403": {
            "description": "Unauthorized or missing token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/factory-inspection/{inspectionId}": {
      "get": {
        "summary": "Get Inspection Data Detail",
        "description": "Get detailed grading payload for a specific inspection by ID or ticket number, matching AGATE format.",
        "tags": ["Inspection Data"],
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "inspectionId",
            "in": "path",
            "description": "Inspection MongoDB ID, document ID, or ticket number",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ticket_number",
            "in": "query",
            "description": "Optional filter by ticket number",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "delivery_number",
            "in": "query",
            "description": "Optional filter by SPB number (spb_no)",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detail retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InspectionDetailResponse"
                }
              }
            }
          },
          "404": {
            "description": "Inspection data not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "FactoryLoginRequest": {
        "type": "object",
        "required": ["api_key", "api_secret"],
        "properties": {
          "api_key": {
            "type": "string",
            "example": "factory_key_123"
          },
          "api_secret": {
            "type": "string",
            "example": "factory_secret_abc"
          }
        }
      },
      "FactoryLoginResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "code": { "type": "integer", "example": 200 },
          "message": {
            "type": "object",
            "properties": {
              "title": { "type": "string", "example": "Success" },
              "m": { "type": "string", "example": "Berhasil login factory" }
            }
          },
          "data": {
            "type": "object",
            "properties": {
              "access_token": { "type": "string" },
              "token_type": { "type": "string", "example": "Bearer" },
              "factory": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "name": { "type": "string" },
                  "company": { "type": "string" }
                }
              }
            }
          }
        }
      },
      "InspectionHeader": {
        "type": "object",
        "properties": {
          "kode_vendor": { "type": "string", "nullable": true },
          "nama_vendor": { "type": "string", "nullable": true },
          "mill_code": { "type": "string", "nullable": true },
          "kelompok_pemasok": { "type": "string", "nullable": true },
          "kode_pemasok": { "type": "string", "nullable": true },
          "no_plat": { "type": "string", "nullable": true },
          "product": { "type": "string", "example": "Fruit Fresh Bunch" },
          "waktu_mulai_timbang": { "type": "string", "nullable": true },
          "waktu_selesai_timbang": { "type": "string", "nullable": true },
          "tanggal_generate_report": { "type": "string", "nullable": true }
        }
      },
      "InspectionTimbangan": {
        "type": "object",
        "properties": {
          "bruto_sistem_kg": { "type": "number", "nullable": true },
          "tare_estimasi_kg": { "type": "number", "nullable": true },
          "berat_brondolan_kg": { "type": "number", "nullable": true },
          "netto_estimasi_kg": { "type": "number", "nullable": true },
          "grade_truck": { "type": "string", "nullable": true }
        }
      },
      "InspectionJanjang": {
        "type": "object",
        "properties": {
          "diterima": { "type": "integer", "nullable": true },
          "dikembalikan": { "type": "integer", "nullable": true },
          "dikembalikan_gross": { "type": "integer", "nullable": true },
          "bjr_kg": { "type": "number", "nullable": true },
          "bjr_flag": { "type": "string", "nullable": true }
        }
      },
      "GradingAiItem": {
        "type": "object",
        "properties": {
          "kode_kriteria": { "type": "string" },
          "nama_kriteria": { "type": "string" },
          "jumlah_janjang": { "type": "integer" },
          "tindakan": { "type": "string" },
          "jjg_diterima": { "type": "integer" },
          "jjg_ditolak": { "type": "integer" },
          "kg_denda": { "type": "number", "nullable": true },
          "parent": { "type": "string", "nullable": true }
        }
      },
      "RedistribusiPotonganItem": {
        "type": "object",
        "properties": {
          "kode_kriteria": { "type": "string" },
          "kriteria": { "type": "string" },
          "ai_pct": { "type": "number" },
          "redistribusi_pct": { "type": "number" },
          "redistribusi_kg": { "type": "number" },
          "parent": { "type": "string", "nullable": true }
        }
      },
      "PotonganTambahan": {
        "type": "object",
        "properties": {
          "buah_busuk_pct": { "type": "number", "nullable": true },
          "pasir_pct": { "type": "number", "nullable": true },
          "air_pct": { "type": "number", "nullable": true },
          "sampah_pct": { "type": "number", "nullable": true },
          "partenokarpi_pct": { "type": "number", "nullable": true },
          "restan_pct": { "type": "number", "nullable": true },
          "abnormal_pct": { "type": "number", "nullable": true },
          "dura_pct": { "type": "number", "nullable": true },
          "pesifera_pct": { "type": "number", "nullable": true },
          "lainnya_pct": { "type": "number", "nullable": true },
          "total_potongan_tambahan_pct": { "type": "number", "nullable": true },
          "total_potongan_ai_pct": { "type": "number", "nullable": true }
        }
      },
      "FormPerhitungan": {
        "type": "object",
        "properties": {
          "form_a_pct": { "type": "number", "nullable": true },
          "form_b_pct": { "type": "number", "nullable": true },
          "potongan_pct": { "type": "number", "nullable": true },
          "adjusted_form_b_pct": { "type": "number", "nullable": true },
          "potongan_final_pct": { "type": "number", "nullable": true }
        }
      },
      "InspectionListItem": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "ticket_id": { "type": "string", "nullable": true },
          "spb_no": { "type": "string", "nullable": true },
          "status": { "type": "string", "example": "final" },
          "grading_mode": { "type": "string", "example": "agate" },
          "model_ai_version": { "type": "string", "nullable": true },
          "header": { "$ref": "#/components/schemas/InspectionHeader" },
          "timbangan": { "$ref": "#/components/schemas/InspectionTimbangan" },
          "janjang": { "$ref": "#/components/schemas/InspectionJanjang" },
          "form_perhitungan": {
            "type": "object",
            "properties": {
              "potongan_final_pct": { "type": "number", "nullable": true }
            }
          },
          "date": { "type": "string", "format": "date-time" }
        }
      },
      "InspectionDetail": {
        "type": "object",
        "properties": {
          "_id": { "type": "string" },
          "ticket_id": { "type": "string", "nullable": true },
          "spb_no": { "type": "string", "nullable": true },
          "status": { "type": "string", "example": "final" },
          "grading_mode": { "type": "string", "example": "agate" },
          "model_ai_version": { "type": "string", "nullable": true },
          "header": { "$ref": "#/components/schemas/InspectionHeader" },
          "timbangan": { "$ref": "#/components/schemas/InspectionTimbangan" },
          "janjang": { "$ref": "#/components/schemas/InspectionJanjang" },
          "grading_ai": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/GradingAiItem" }
          },
          "buah_hitam_diterima": { "type": "integer", "nullable": true },
          "redistribusi_potongan": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RedistribusiPotonganItem" }
          },
          "potongan_tambahan": { "$ref": "#/components/schemas/PotonganTambahan" },
          "form_perhitungan": { "$ref": "#/components/schemas/FormPerhitungan" },
          "remark": { "type": "string", "nullable": true },
          "audit": {
            "type": "object",
            "properties": {
              "created_at": { "type": "string" },
              "created_by": { "type": "string" },
              "updated_at": { "type": "string" },
              "updated_by": { "type": "string" }
            }
          }
        }
      },
      "InspectionListResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "code": { "type": "integer", "example": 200 },
          "message": {
            "type": "object",
            "properties": {
              "title": { "type": "string", "example": "Success" },
              "m": { "type": "string", "example": "Berhasil mendapatkan daftar data inspeksi factory" }
            }
          },
          "data": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/InspectionListItem" }
          },
          "meta": {
            "type": "object",
            "properties": {
              "total_data": { "type": "integer" },
              "page": { "type": "integer" },
              "limit": { "type": "integer" },
              "total_pages": { "type": "integer" }
            }
          }
        }
      },
      "InspectionDetailResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": true },
          "code": { "type": "integer", "example": 200 },
          "message": {
            "type": "object",
            "properties": {
              "title": { "type": "string", "example": "Success" },
              "m": { "type": "string", "example": "Berhasil mendapatkan detail data inspeksi factory" }
            }
          },
          "data": { "$ref": "#/components/schemas/InspectionDetail" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean", "example": false },
          "code": { "type": "integer", "example": 401 },
          "message": {
            "type": "object",
            "properties": {
              "title": { "type": "string" },
              "m": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
